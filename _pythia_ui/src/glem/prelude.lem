-- glem's prelude: what every glem program has, after lem's. glem derives
-- `Parent` for every widget; the runtime around glem fills in where the
-- pointer and the keyboard are, and sends what keys say.

-- The tree: each widget's parent, and what each is within, which only a
-- program that reads it derives (`lazy`).
rel Parent(id: Id, parent: Id) key id
rel Within(id: Id, outer: Id) lazy
Within(w, p) :- Parent(w, p)
Within(w, a) :- Parent(w, p), Within(p, a)

-- Keys, which send a message while the rules say so.
enum Chord:
  Escape, Return, Tab
rel Key(chord: Chord, msg: Msg)

-- Where the pointer and the keyboard are, new each tick.
input Hovered(id: Id)
input Pressed(id: Id)
input Focused(id: Id)
