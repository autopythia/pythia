-- glem's prelude: what every glem program has, after lem's. glem derives
-- `Parent` for every widget; the runtime around glem fills in where the
-- pointer and the keyboard are, and sends what keys say.

-- The tree: each widget's parent, and what each is within, which only a
-- program that reads it derives (`lazy`).
rel Parent(id: Id, parent: Id) key id
rel Within(id: Id, outer: Id) lazy
Within(w, p) :- Parent(w, p)
Within(w, a) :- Parent(w, p), Within(p, a)

-- Keys, which send a message while the rules say so.
enum Chord:
  Escape, Return, Tab
rel Key(chord: Chord, msg: Msg)

-- Widgets that send a message when they come near the screen, within a
-- screen's height of it, while the rules say so: as a page that loads more
-- of a log when its end comes near. A widget sends its messages again when
-- they change while it's near.
rel Near(id: Id, msg: Msg)

-- Widgets to bring into view: the view scrolls the widget that a Reveal
-- fact names into view, once for each `at`, as soon as its element shows,
-- as a page that jumps to a row does once the row has come; and marks it,
-- for a look to show, until it brings another into view.
rel Reveal(id: Id, at: Int)

-- Where the pointer and the keyboard are, new each tick.
input Hovered(id: Id)
input Pressed(id: Id)
input Focused(id: Id)
