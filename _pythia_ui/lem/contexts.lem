-- contexts.lem: pythia's contexts, as its node server's glui view shows
-- them (pythia/interaction/node/view.py): the index of root contexts, or
-- one context's log, a page each, in glui's widgets. The host sends a
-- page's facts: for a log, its turns and its last rows. More rows come as
-- either end of those that came comes near the screen, a run's items once
-- it's opened, and an item's body once it's opened, when the program asks
-- for them (LoadBefore, LoadAfter, LoadRun, Load); and a log grows, as
-- the host says. In a browser, web/contexts.js is the host's part.
type CtxId = Text

-- A page: its title; for a log, where each item has a page of its own:
-- `items`, then its line; where each turn has one: `turns`, then its
-- number; and its first line; and links to other pages, in order.
input Page(title: Text, items: Text = "", turns: Text = "", first: Int = 0) one
input Nav(n: Int, text: Text, to: Text) key n

-- A log's length, in lines, which grows as its context works: the host
-- says so as it learns it, each length in place of the last. It's apart
-- from Page, which every widget of the page reads.
input Length(lines: Int) one

-- The index: each context, by `rank`, the last changed first.
input Context(id: CtxId, title: Text, model: Text, turns: Int, lines: Int, size: Text, changed: Text, rank: Int, to: Text) key id

-- A log, in order. Its turns, each with its label, such as `Turn 12 · 51
-- items`, its title, the user's input, and the line where it starts. The
-- stretches of it that came (Chunk), each from one line to another, and
-- the rows there: messages, user and assistant, each with its text whole;
-- and runs, the other items between two messages within a turn, each with
-- what's in it and its last line. For a run that was opened, its items, by
-- line, each with its tone, label and gist, and whether it has a body, or
-- why the host couldn't send them; for an item that was opened, its body's
-- parts, or why the host couldn't send them; and why the host couldn't
-- send the rows before a line, or after one.
input Turn(n: Int, label: Text, title: Text, line: Int) key n
input Chunk(first: Int, last: Int) key first
input Message(line: Int, turn: Int, tone: Tone, label: Text, text: Text) key line
input Run(line: Int, turn: Int, last: Int, text: Text) key line
input RunLoaded(run: Int) key run
input RunFailed(run: Int, why: Text) key run
input Item(line: Int, run: Int, tone: Tone, label: Text, gist: Text, body: Bool) key line
input Body(line: Int, part: Int, text: Text, diff: Bool) key line, part
input Failed(line: Int, why: Text) key line
input EarlierFailed(line: Int, why: Text) key line
input LaterFailed(line: Int, why: Text) key line

-- What the program asks the host for: the rows before a line, or after
-- one, as either end of those that came comes near the screen (Near); a
-- run's items, and an item's body, when each is opened.
effect LoadBefore(line: Int)
effect LoadAfter(line: Int)
effect LoadRun(run: Int)
effect Load(line: Int)
msg Earlier(line: Int), Later(line: Int), Fill(run: Int)
state Opened(run: Int) key run
state Asked(line: Int) key line

-- Whether every run is open, as the host says, from its bar (Opening); or
-- folded, as when it doesn't say. Each run, and each item, still opens and
-- folds alone; and a run that's open asks for its items as it comes near
-- the screen.
input Opening(open: Bool) one
rel Opens(open: Bool) one
Opens(o) :- Opening(o)
Opens(False) :- not Opening()

-- Stars: the host's, for this log, by line (Stars). A message, and an item,
-- has a star, which the reader sets or clears (glui's Starred), and which
-- the program asks the host to keep (Star).
input Stars(line: Int)
effect Star(line: Int, on: Bool)
rel StarOf(line: Int, on: Bool) key line
StarOf(l, True) :- Stars(l)
StarOf(l, False) :- Message(line=l), not Stars(l)
StarOf(i, False) :- Item(line=i), not Stars(i)

-- Jumping to a line, as the panel's pins do: the rows around it come, as
-- the host sends them (LoadAround); the run that it's in opens; and its
-- message, or its item, comes into view (glem's Reveal); before the item's
-- run has its items, the run. Visiting a turn, as the panel's outline
-- does, is a jump to the line where it first shows, which brings the
-- turn's mark into view, and opens nothing. Each jump counts, so that one
-- to the same line again brings it into view again.
msg Jump(line: Int), Visit(turn: Int)
effect LoadAround(line: Int)
state Jumped(line: Int, n: Int, turn: Bool) one
rel Reached(run: Int)
Reached(r) :- Jumped(l, _, False), Run(r, _, last, _), r <= l, l <= last, not Message(line=l)
rel Target(id: Id)
Target(TurnMark(t)) :- Jumped(l, _, True), Turn(t, _, _, l)
Target(Said(l)) :- Jumped(l, _, False), Message(line=l)
Target(Ent(l)) :- Jumped(l, _, False), Item(line=l), not Message(line=l)
Target(RunBox(r)) :- Reached(r), Jumped(l, _, False), not Item(line=l)
Reveal(id, at=n) :- Target(id), Jumped(_, n, _)

-- The panel beside a log, which shows as the host says, from its bar
-- (Aside): the lines starred, by turn, as the host sends them (Pin), each
-- with its turn, tone, label and gist; for a starred answer, the user's
-- messages before it in its turn, which it answers, come with it. Then the
-- outline of the log's turns, each with its label and the user's input. A
-- click on a line, or a turn, jumps to it.
input Aside(shown: Bool) one
input Pin(line: Int, turn: Int, tone: Tone, label: Text, gist: Text) key line
rel Pinned(turn: Int)
Pinned(n) :- Pin(turn=n)
rel TurnText(n: Int, text: Text) key n
TurnText(n, head + ": " + title) :- Turn(n, head, title, _), title /= ""
TurnText(n, head) :- Turn(n, head, "", _)

-- Each run open or folded: open as the host says (Opens), or as a jump
-- reaches into it.
rel RunOpen(run: Int, open: Bool) key run
RunOpen(r, True) :- Reached(r)
RunOpen(r, o) :- Run(line=r), Opens(o), not Reached(r)

-- The lines that came, from the first to the last; and where rows are.
rel Below(line: Int)
Below(f) :- Chunk(f, _), Chunk(g, _), g < f
rel First(line: Int) one
First(f) :- Chunk(f, _), not Below(f)
rel Above(line: Int)
Above(t) :- Chunk(_, t), Chunk(_, u), u > t
rel Last(line: Int) one
Last(t) :- Chunk(_, t), not Above(t)
rel RowAt(line: Int)
RowAt(l) :- Message(l, _, _, _, _)
RowAt(l) :- Run(l, _, _, _)

-- Where the stretches that came don't meet, as after a jump: after each,
-- the next, if rows lie between them, which a marker at either side asks
-- for as it comes near the screen.
rel Ahead(last: Int, first: Int)
Ahead(t, f) :- Chunk(_, t), Chunk(f, _), f > t
rel Farther(last: Int, first: Int)
Farther(t, f) :- Ahead(t, f), Ahead(t, g), g < f
rel Continues(last: Int)
Continues(t) :- Chunk(_, t), Chunk(a, b), a <= t + 1, t + 1 <= b
rel Gap(last: Int, first: Int)
Gap(t, f) :- Ahead(t, f), not Farther(t, f), not Continues(t)

id Top, Title, Crumbs, Crumb(Int), Rows, Head, Col(Int), Ctx(CtxId), Cell(CtxId, Int)
id Log, Before, After, TurnMark(Int), Said(Int), SaidText(Int), RunBox(Int), RunWait(Int)
id Ent(Int), Part(Int, Int), Wait(Int), GapAfter(Int), GapBefore(Int)
id Side, Pins, NoPins, PinTurn(Int), PinRow(Int), TurnList, TurnRow(Int)

Window(Top, title=t) :- Page(t, items, turnto, begin):
  Heading(Title, text=t)
  Row(Crumbs) :- Nav():
    for Nav(n, text, to):
      Link(Crumb(n), text=text, to=to, order=n)
  Table(Rows) :- Context():
    TableRow(Head, header=True, order=-1):
      Label(Col(0), text="Context")
      Label(Col(1), text="Title")
      Label(Col(2), text="Model")
      Label(Col(3), text="Turns")
      Label(Col(4), text="Lines")
      Label(Col(5), text="Size")
      Label(Col(6), text="Changed")
    for Context(c, title, model, turns, lines, size, changed, rank, to):
      TableRow(Ctx(c), order=rank):
        Link(Cell(c, 0), text=text(c), to=to)
        Label(Cell(c, 1), text=title)
        Label(Cell(c, 2), text=model, tone=Dim)
        Label(Cell(c, 3), text=text(turns))
        Label(Cell(c, 4), text=text(lines))
        Label(Cell(c, 5), text=size)
        Label(Cell(c, 6), text=changed, tone=Dim)
  Box(Log) :- Chunk():
    Label(Before, text="earlier rows", tone=Dim, order=-1) :- First(f), f > begin, not EarlierFailed(line=f)
    Label(Before, text="couldn't load the earlier rows: " + why, tone=Error, order=-1) :- First(f), f > begin, EarlierFailed(f, why)
    for Turn(n, head, title, start):
      Entry(TurnMark(n), label=head, text="", mark=text(n), tone=Strong, to=turnto + text(n), order=start * 2 - 1) :- RowAt(start)
    for Message(l, n, tone, label, said):
      Entry(Said(l), label=label, text="", mark=text(l), tone=tone, to=items + text(l), order=l * 2, star=True, starred=s) :- StarOf(l, s):
        Code(SaidText(l), text=said)
    for Run(l, n, last, what):
      Entry(RunBox(l), label=what, text="", mark=text(l), tone=Dim, fold=True, to=items + text(l), order=l * 2, open=o) :- RunOpen(l, o):
        Label(RunWait(l), text="loading", tone=Dim) :- Opened(l), not RunLoaded(run=l), not RunFailed(run=l)
        Label(RunWait(l), text="couldn't load it: " + why, tone=Error) :- RunFailed(l, why), not RunLoaded(run=l)
        for Item(i, l, tone, label, gist, body):
          Entry(Ent(i), label=label, text=gist, mark=text(i), tone=tone, fold=body, to=items + text(i), order=i, star=True, starred=s) :- StarOf(i, s):
            Code(Part(i, k), text=b, diff=d, order=k) :- Body(i, k, b, d)
            Label(Wait(i), text="loading", tone=Dim) :- Asked(i), not Body(line=i), not Failed(line=i)
            Label(Wait(i), text="couldn't load it: " + why, tone=Error) :- Failed(i, why), not Body(line=i)
    for Gap(above, below):
      Label(GapAfter(above), text="later rows", tone=Dim, order=above * 2 + 1) :- not LaterFailed(line=above)
      Label(GapAfter(above), text="couldn't load the later rows: " + why, tone=Error, order=above * 2 + 1) :- LaterFailed(above, why)
      Label(GapBefore(below), text="earlier rows", tone=Dim, order=below * 2 - 2) :- not EarlierFailed(line=below)
      Label(GapBefore(below), text="couldn't load the earlier rows: " + why, tone=Error, order=below * 2 - 2) :- EarlierFailed(below, why)
    Label(After, text="later rows", tone=Dim, order=finish * 2 + 1) :- Last(upto), Length(finish), upto < finish, not LaterFailed(line=upto)
    Label(After, text="couldn't load the later rows: " + why, tone=Error, order=finish * 2 + 1) :- Last(upto), Length(finish), upto < finish, LaterFailed(upto, why)

Hud(Side, place=TopRight) :- Aside(True):
  Panel(Pins, title="Starred"):
    Label(NoPins, text="Nothing is starred yet.", tone=Dim) :- not Pin()
    for Pinned(n):
      Label(PinTurn(n), text=words, tone=Dim, order=start * 2 - 1) :- TurnText(n, words), Turn(n, _, _, start)
    for Pin(l, n, tone, label, gist):
      ListRow(PinRow(l), text=label + " " + gist, on=Jump(l), order=l * 2)
  Panel(TurnList, title="Turns"):
    for TurnText(n, words):
      ListRow(TurnRow(n), text=words, on=Visit(n), order=n)

-- Either end of the rows that came asks for more as it comes near the
-- screen, unless the host couldn't send them.
Near(Before, msg=Earlier(f)) :- First(f), Page(first=p), f > p, not EarlierFailed(line=f)
Near(After, msg=Later(t)) :- Last(t), Length(p), t < p, not LaterFailed(line=t)
Near(RunBox(l), msg=Fill(l)) :- RunOpen(l, True), not RunLoaded(run=l), not RunFailed(run=l)
Near(GapAfter(t), msg=Later(t)) :- Gap(t, _), not LaterFailed(line=t)
Near(GapBefore(f), msg=Earlier(f)) :- Gap(_, f), not EarlierFailed(line=f)

on Earlier(f):
  LoadBefore(f)

on Later(t):
  LoadAfter(t)

on Toggled(RunBox(l), True):
  Opened(l) :- Run(line=l), not RunLoaded(run=l)
  LoadRun(l) :- Run(line=l), not RunLoaded(run=l)

on Fill(l):
  Opened(l) :- Run(line=l), not RunLoaded(run=l)
  LoadRun(l) :- Run(line=l), not RunLoaded(run=l)

on Jump(l):
  Jumped(l, n + 1, False) :- Jumped(_, n, _)
  Jumped(l, 1, False) :- not Jumped()
  LoadAround(l)

on Visit(t):
  Jumped(l, n + 1, True) :- Turn(t, _, _, l), Jumped(_, n, _)
  Jumped(l, 1, True) :- Turn(t, _, _, l), not Jumped()
  LoadAround(l) :- Turn(t, _, _, l)

on Starred(Said(l), v):
  Star(l, v)

on Starred(Ent(i), v):
  Star(i, v)

on Toggled(Ent(i), True):
  Asked(i) :- Item(line=i, body=True), not Body(line=i)
  Load(i) :- Item(line=i, body=True), not Body(line=i)
