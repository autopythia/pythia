-- tabs.lem: the tab strip of the glui view of pythia's node server
-- (pythia/interaction/node/view.py), in a HUD at the top left: the index
-- first, then each context that's open, in the order opened, as the host
-- says (Open, the index as 0), and the tab that shows (Shown). Picking a
-- tab asks the host to show it (Show), closing one, to close it (Close),
-- and dragging one onto another, to move it there (Move); the index can't
-- be closed, or moved. In a browser, web/contexts.js is the host's part.
input Open(n: Int, title: Text, rank: Int) key n
input Shown(n: Int) one
effect Show(n: Int)
effect Close(n: Int)
effect Move(n: Int, to: Int)

-- Whether each tab shows, and whether it closes.
rel Showing(n: Int, on: Bool) key n
Showing(n, True) :- Open(n, _, _), Shown(n)
Showing(n, False) :- Open(n, _, _), not Shown(n)
rel Closes(n: Int, on: Bool) key n
Closes(0, False) :- Open(0, _, _)
Closes(n, True) :- Open(n, _, _), n /= 0

id Strip, Strips, TabOf(Int)

Hud(Strip, place=TopLeft) :- Open():
  Tabs(Strips):
    for Open(n, title, rank):
      TabItem(TabOf(n), text=title, active=a, closes=c, moves=c, order=rank) :- Showing(n, a), Closes(n, c)

on Chosen(TabOf(n)):
  Show(n)

on Dismissed(TabOf(n)):
  Close(n)

on Moved(TabOf(n), TabOf(m)):
  Move(n, m)
