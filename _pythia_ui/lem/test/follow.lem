-- follow.lem: how a tick follows what changed (src/lem/eval.rs). A rule
-- that reads one relation that changed, at an atom that it follows, joins
-- there just the facts that came and went; one that reads it in a negation,
-- or reads more than one that changed, or has an atom that counts one fact
-- or each by the order of the join, runs whole. A fact holds by the
-- lowest-numbered rule that derives it.
input A(n: Int, m: Int)
input B(n: Int)
input C(n: Int)
input E(a: Int, b: Int)

-- P(n) by each of A's facts for n, and by B(n).
rel P(n: Int)
P(n) :- A(n, _)
P(n) :- B(n)

-- PP follows P's changes, which P's rules make.
rel PP(n: Int)
PP(n) :- P(n)

-- Q reads B in a negation.
rel Q(n: Int)
Q(n) :- A(n, m), not B(n)

-- Both's A(n, _) counts one fact or each, by the order of the join.
rel Both(n: Int)
Both(n) :- B(n), A(n, _)

-- Any's C(_) is a test.
rel Any(n: Int)
Any(n) :- B(n), C(_)

-- Path reads E twice, and follows both; Reach is recursive; Far follows it.
rel Path(a: Int, c: Int)
Path(a, c) :- E(a, b), E(b, c)
rel Reach(a: Int, b: Int)
Reach(a, b) :- E(a, b)
Reach(a, c) :- Reach(a, b), E(b, c)
rel Far(a: Int)
Far(a) :- Reach(a, _)

-- Huge overflows for C(10), and the relations derived after it then have no
-- facts; Twice binds and tests; K's key clashes for two of C's facts below 4.
rel Huge(n: Int)
Huge(n * 1000000000000000) :- C(n)
rel Twice(n: Int, t: Int)
Twice(n, t) :- C(n), t = n * 2, t > 2
rel K(k: Int, n: Int) key k
K(0, n) :- C(n), n < 4

-- The order of facts in an index: a test of G(n, Big(_)) visits G's facts
-- for n in their order, up to the first Big, which both runtimes keep alike,
-- whichever order the facts came in.
enum Size:
  Big(n: Int), Small(n: Int)
input G(n: Int, size: Size)
input J(n: Int)
rel H(n: Int)
H(n) :- J(n), G(n, Big(_))

-- Over has no facts to keep while N holds none over 99: a tick that brings
-- more of N than stayed starts it over, running its rule whole as its first
-- tick did; one that brings fewer follows what came.
input N(n: Int)
rel Over(n: Int)
Over(n) :- N(n), n > 99

-- The order in which a whole run notes the facts that it adds: as its rules
-- derive them, Small's rule before Big's, though Big's facts come first in
-- value. Sizes, which has facts to keep, follows them in that order, into
-- its index, which Found's rule then walks to the first Big: so the order
-- sets how many facts it visits, which both runtimes must agree on.
input Seed(n: Int, k: Int)
rel Sized(n: Int, size: Size)
Sized(n, Small(k)) :- Seed(n, k), k < 5
Sized(n, Big(k)) :- Seed(n, k), k > 4
input Kept(n: Int, size: Size)
rel Sizes(n: Int, size: Size)
Sizes(n, s) :- Sized(n, s)
Sizes(n, s) :- Kept(n, s)
input Probe(n: Int)
rel Found(n: Int)
Found(n) :- Probe(n), Sizes(n, Big(_))

-- What a change leaves as it was. A test that binds nothing, as a block's
-- condition such as `Turn()` gives, holds while its relation has facts, so a
-- change that leaves it so changes none of a rule's solutions: Heard follows
-- a new round alone, and Unheard, which reads Round only in such a test, has
-- nothing to follow. Nor does a literal that no fact that came or went could
-- match: Early's `not Round(3)`, while round 3 neither comes nor goes. And a
-- test of another fixed pattern holds before and after when facts that it
-- matches both came and went: Moded's `Mode(1, _)`, as mode 1's value changes.
input Round(n: Int)
input Said(w: Int, n: Int)
input Mode(n: Int, value: Text) key n
rel Heard(w: Int)
Heard(w) :- Round(_), Round(n), Said(w, n)
rel Unheard(w: Int)
Unheard(w) :- Said(w, _), not Round(_)
rel Early(w: Int)
Early(w) :- Said(w, 1), not Round(3)
rel Moded(w: Int)
Moded(w) :- Said(w, _), Mode(1, _)

-- Self's E(a, a) matches only an edge from a node to itself, which none of
-- the edges that come and go above is: no change of E changes it, though
-- E(a, b) could match each.
rel Self(a: Int)
Self(a) :- E(a, a)

-- Both of AB's relations change in one tick: it follows each, with the
-- other as it is now before it, and as it was after it, so that each way
-- to derive a fact that comes or goes counts once.
rel AB(n: Int)
AB(n) :- A(n, m), B(n)

-- R3's D and V change in one tick. Following what came to D, with V as it
-- was, the join compares V's bucket for 30, as it was, with W's: V's facts
-- for 30 all came, so V had none, and the join stops there, before W's.
input D(n: Int)
input V(n: Int, m: Int)
input W(n: Int, m: Int)
rel R3(n: Int)
R3(n) :- D(n), V(n, m), W(n, k)
-- Lone's Mark(m) has a variable that appears nowhere else in its rule, as a
-- block's condition often has: each of Each's facts derives Lone once for
-- each of Mark's. A change that leaves how many facts Mark has, such as one
-- replaced by another, changes none of Lone's counts and has nothing to
-- follow, even as Each changes too; one that makes them more or fewer does.
input Each(n: Int)
input Mark(m: Int)
rel Lone(n: Int)
Lone(n) :- Each(n), Mark(m)
-- An atom that shares a variable only with a negation, a comparison or a
-- binding isn't alone: as a mark is replaced, Unbanned's Mark(m), Under's and
-- Next's match other facts, which those parts take or refuse. Nor is one
-- with an expression, which a fact may match or not by its value: Paired's
-- Pair(m, 1 + 1).
input Banned(m: Int)
input Pair(m: Int, k: Int)
rel Unbanned(n: Int)
Unbanned(n) :- Each(n), Mark(m), not Banned(m)
rel Under(n: Int)
Under(n) :- Each(n), Mark(m), m < 5
rel Next(n: Int, k: Int)
Next(n, k) :- Each(n), Mark(m), k = m + 1
rel Paired(n: Int)
Paired(n) :- Each(n), Pair(m, 1 + 1)
