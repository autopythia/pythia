-- tasks.lem: a task list, for glem's tests, with toy widgets of its own so
-- that it runs on glem alone.
surface Screen(title: Text)
widget Group(title: Text)
widget Item(text: Text, on: Msg)
widget Line(text: Text)
id Top, List, Row(Text), Editor(Text), Footer, Stray, Nowhere, Loop(Int)

input Todo(id: Text, title: Text, at: Time) key id
-- State that names a widget goes with the widget, unless it says `keep`.
state Editing(row: Id)
state Draft(row: Id, text: Text) key row
state Pinned(row: Id) keep
msg Open(todo: Text), Pin(todo: Text), Type(todo: Text, text: Text)

Screen(Top, title="Tasks") :- Todo():
  Group(List, title="Open"):
    for Todo(t, title, at):
      Item(Row(t), text=title, order=at, on=Open(t)):
        Line(Editor(t), text=d) :- Editing(Row(t)), Draft(Row(t), d)
  Line(Footer, text="pinned") :- Pinned(_)

on Open(t):
  Editing(Row(t))
on Pin(t):
  Pinned(Row(t))
on Type(t, text):
  Draft(Row(t), text=text)

-- Broken trees, for the runtime's errors: a second widget with a row's id,
-- a parent that isn't a widget, and two widgets that parent each other.
Line(Row(t), parent=List, text="again") :- Todo(t, "twice", _)
Line(Stray, parent=Nowhere, text="lost") :- Todo(_, "stray", _)
Line(Loop(1), parent=Loop(2), text="1") :- Todo(_, "loop", _)
Line(Loop(2), parent=Loop(1), text="2") :- Todo(_, "loop", _)

-- Escape pins the row that has the keyboard's focus, which glem's runtime in
-- JavaScript fills in; and typing a draft tells the host.
Key(Escape, msg=Pin(t)) :- Focused(Row(t))
effect Saved(todo: Text, text: Text)
on Type(t, text):
  Saved(t, text=text)

-- A second widget under the parent that isn't one: the error names the
-- first, by id.
id Strayed
Line(Strayed, parent=Nowhere, text="lost too") :- Todo(_, "stray", _)

-- A row's note, under the row, which the host gives apart from it: if the
-- row goes and the note stays, the note's parent isn't a widget.
id Note(Text)
input Noted(todo: Text)
Line(Note(t), parent=Row(t), text="noted") :- Noted(t)

-- A folder, a group while it's open and a row while it isn't, with a line
-- inside that stays as the folder changes its kind.
id Folder, Inside
input Opened(open: Bool)
Group(Folder, parent=List, title="folder", order=0) :- Opened(True)
Item(Folder, parent=List, text="folder", on=Pin("folder"), order=0) :- Opened(False)
Line(Inside, parent=Folder, text="inside") :- Opened(_)
